[{"start": 0, "end": 4.478775510204081, "text": "Every morning, I take a small step toward something new.", "words": [{"text": "Every", "start": 0.05, "end": 0.4945505861919236}, {"text": " morning,", "start": 0.4945505861919236, "end": 1.2058315240990014}, {"text": " I", "start": 1.2058315240990014, "end": 1.294741641337386}, {"text": " take", "start": 1.294741641337386, "end": 1.6503821102909249}, {"text": " a", "start": 1.6503821102909249, "end": 1.7392922275293095}, {"text": " small", "start": 1.7392922275293095, "end": 2.183842813721233}, {"text": " step", "start": 2.183842813721233, "end": 2.5394832826747717}, {"text": " toward", "start": 2.5394832826747717, "end": 3.07294398610508}, {"text": " something", "start": 3.07294398610508, "end": 3.873135041250542}, {"text": " new.", "start": 3.873135041250542, "end": 4.2287755102040805}]}, {"start": 4.478775510204081, "end": 8.012517006802721, "text": "Learning a language is not about being perfect.", "words": [{"text": "Learning", "start": 4.528775510204081, "end": 5.175523809523809}, {"text": " a", "start": 5.175523809523809, "end": 5.256367346938775}, {"text": " language", "start": 5.256367346938775, "end": 5.903115646258502}, {"text": " is", "start": 5.903115646258502, "end": 6.0648027210884345}, {"text": " not", "start": 6.0648027210884345, "end": 6.307333333333332}, {"text": " about", "start": 6.307333333333332, "end": 6.711551020408162}, {"text": " being", "start": 6.711551020408162, "end": 7.115768707482992}, {"text": " perfect.", "start": 7.115768707482992, "end": 7.76251700680272}]}, {"start": 8.012517006802721, "end": 13.251156462585033, "text": "It is about showing up, listening closely, and trying again.", "words": [{"text": "It", "start": 8.062517006802722, "end": 8.256189142323597}, {"text": " is", "start": 8.256189142323597, "end": 8.449861277844473}, {"text": " about", "start": 8.449861277844473, "end": 8.934041616646661}, {"text": " showing", "start": 8.934041616646661, "end": 9.611894090969724}, {"text": " up,", "start": 9.611894090969724, "end": 9.902402294251036}, {"text": " listening", "start": 9.902402294251036, "end": 10.773926904094974}, {"text": " closely,", "start": 10.773926904094974, "end": 11.548615446178474}, {"text": " and", "start": 11.548615446178474, "end": 11.839123649459786}, {"text": " trying", "start": 11.839123649459786, "end": 12.420140056022412}, {"text": " again.", "start": 12.420140056022412, "end": 13.001156462585037}]}, {"start": 13.251156462585033, "end": 15.460453514739228, "text": "Choose one sentence.", "words": [{"text": "Choose", "start": 13.301156462585034, "end": 13.9375888133031}, {"text": " one", "start": 13.9375888133031, "end": 14.255804988662131}, {"text": " sentence.", "start": 14.255804988662131, "end": 15.210453514739228}]}, {"start": 15.460453514739228, "end": 17.509614512471654, "text": "Listen to the rhythm.", "words": [{"text": "Listen", "start": 15.510453514739229, "end": 16.093507180650036}, {"text": " to", "start": 16.093507180650036, "end": 16.287858402620305}, {"text": " the", "start": 16.287858402620305, "end": 16.57938523557571}, {"text": " rhythm.", "start": 16.57938523557571, "end": 17.259614512471654}]}, {"start": 17.509614512471654, "end": 20.168843537414965, "text": "Then say it in your own voice.", "words": [{"text": "Then", "start": 17.559614512471654, "end": 17.952819349962205}, {"text": " say", "start": 17.952819349962205, "end": 18.24772297808012}, {"text": " it", "start": 18.24772297808012, "end": 18.444325396825395}, {"text": " in", "start": 18.444325396825395, "end": 18.64092781557067}, {"text": " your", "start": 18.64092781557067, "end": 19.03413265306122}, {"text": " own", "start": 19.03413265306122, "end": 19.329036281179135}, {"text": " voice.", "start": 19.329036281179135, "end": 19.918843537414965}]}, {"start": 20.168843537414965, "end": 24.272607709750567, "text": "A little practice today can make a big difference tomorrow.", "words": [{"text": "A", "start": 20.218843537414966, "end": 